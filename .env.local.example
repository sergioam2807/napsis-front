# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=genera-uno-con-openssl-rand-base64-32

# Google OAuth (Google Cloud Console → Credenciales → ID de cliente OAuth, app web)
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# Worker (Railway en producción)
WORKER_URL=http://localhost:3001
WORKER_API_KEY=misma-clave-que-API_KEY-del-worker

# Slug del colegio que aparece por defecto (snd.napsis.cl/<colegio>/...)
NEXT_PUBLIC_DEFAULT_COLEGIO=rayencaven

# Opcional: restringe el acceso a correos de estos dominios (separados por coma)
# ALLOWED_EMAIL_DOMAINS=colegio.cl
